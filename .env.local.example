GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=  # paste base64-encoded JSON key here
NEXT_PUBLIC_APP_NAME=NetSuite Commercial KPIs

# NextAuth (Google SSO)
AUTH_SECRET=  # run: openssl rand -base64 32
AUTH_GOOGLE_ID=  # from Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_SECRET=  # from Google Cloud Console → APIs & Services → Credentials
NEXTAUTH_URL=http://localhost:3000  # change to your Vercel URL in production

# Database sync (Supabase Postgres)
DATABASE_URL=  # Supabase pooled connection string, Transaction mode, port 6543
SYNC_SECRET=  # random secret shared with the GitHub Actions sync workflow — run: openssl rand -base64 32
ALERT_WEBHOOK_URL=  # optional — Slack/Discord incoming webhook for sync failures. Skipped for v1.
DATA_SOURCE=  # leave unset (defaults to database). Set to "sheets" to roll back to the pre-migration live-Sheets read path.
